From 593e7650e00db8f7646a9a82863d6a1a741dfb75 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 27 Jun 2026 14:51:58 +0000
Subject: [PATCH] feat: live stats summary card for featured reviews

Adds /api/public/reviews/stats endpoint returning total approved reviews,
average rating, and star distribution. Featured section now fetches and
displays these live values in the left summary card (score, stars, count,
distribution bars) instead of manual settings.
---
 app/(admin)/reviews/embed/page.tsx    | 35 +++++++++++++++++--
 app/api/public/reviews/stats/route.ts | 49 +++++++++++++++++++++++++++
 2 files changed, 81 insertions(+), 3 deletions(-)
 create mode 100644 app/api/public/reviews/stats/route.ts

diff --git a/app/(admin)/reviews/embed/page.tsx b/app/(admin)/reviews/embed/page.tsx
index 01e1eb0..e522e25 100644
--- a/app/(admin)/reviews/embed/page.tsx
+++ b/app/(admin)/reviews/embed/page.tsx
@@ -80,8 +80,8 @@ const FEATURED_SECTION_LIQUID = (apiBase: string) => `{% comment %}
     </div>
 
     <div class="brn-feat-grid">
-      <div class="brn-feat-summary">
-        <div class="brn-feat-score">{{ section.settings.summary_score }}<span>/5</span></div>

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL="postgresql://brnadmin:brnadmin@localhost:5432/brnadmin"
POSTGRES_USER=brnadmin
POSTGRES_PASSWORD=brnadmin
POSTGRES_DB=brnadmin

# --- NextAuth ---
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Shopify Admin API (Custom App) ---
SHOPIFY_STORE_URL="magazanin-adi.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-01"

# Eski XML Engine için (aynı token'ı tekrarla)
SHOPIFY_DEFAULT_SHOP="magazanin-adi.myshopify.com"
SHOP_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxx"
SHOPIFY_SCOPES="read_products,write_products,read_orders,read_customers"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Email (Resend) — opsiyonel ---
# Boş bırakırsan MOCK modda çalışır (DB'ye log düşer, mail gitmez)
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="BRN Admin <onboarding@resend.dev>"

# --- AI Asistan (Anthropic Claude) — opsiyonel ---
# Boş bırakırsan AI asistan MOCK cevap döner
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Public Widget CORS ---
# Hangi domainlerden widget istek atabilir (virgülle ayır, * = hepsi)
# Production'da MUTLAKA daralt: sekerco.com,sekerco.myshopify.com
WIDGET_ALLOWED_ORIGINS="*"

# --- E2E Test (Playwright) ---
TEST_USER_EMAIL="baran@sekerco.com"
TEST_USER_PASSWORD="admin"

# --- Otomasyon / Cron ---
# Vercel Cron (veya harici scheduler) bu secret'i "Authorization: Bearer {secret}" ile gönderir.
# Panelden de girilebilir: Ayarlar → API & Entegrasyon → Otomasyon (Cron)
CRON_SECRET=""

# --- Kargo Taşıyıcıları (opsiyonel — panelden de girilebilir) ---
CARGO_MNG_CLIENT_ID=""
CARGO_MNG_CLIENT_SECRET=""
CARGO_MNG_CUSTOMER=""
CARGO_ARAS_USERNAME=""
CARGO_ARAS_PASSWORD=""
CARGO_YURTICI_USERNAME=""
CARGO_YURTICI_PASSWORD=""

# NOT: Envanter Lokasyonları için SHOPIFY_SCOPES'a read_locations ekleyin.

# --- App ---
PORT=3000
NODE_ENV=development
